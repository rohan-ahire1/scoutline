# Optional: live Google Maps business discovery
BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_DATASET_ID=gd_m8ebnr0q2qlklc02fz
# BRIGHT_DATA_MAX_RECORDS=25

# Optional: model-generated outreach (Meta is preferred when both providers are set)
MODEL_API_KEY=
META_MODEL=muse-spark-1.2-contributor
# META_REASONING_EFFORT=minimal
# META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Optional: email autopilot (Outreach page). A Google app password for the
# Workspace mailbox that sends; needs 2-Step Verification on that account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# GMAIL_FROM_NAME=Rohan Ahire

# Optional local overrides
# SCOUTLINE_PORT=8787
# SCOUTLINE_DATA_DIR=/absolute/path/to/scoutline-data
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Required: Google login and exact-match email allowlist
GOOGLE_CLIENT_ID=
SCOUTLINE_ALLOWED_EMAILS=you@example.com,teammate@example.com
