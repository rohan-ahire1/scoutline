[Unit]
Description=Scoutline nightly market discovery (queues tonight's slice)
After=network-online.target scoutline.service scoutline-worker.service
Wants=network-online.target

[Service]
Type=oneshot
User=rohan
Group=rohan
WorkingDirectory=/home/rohan/projects/scoutline/current
Environment=PATH=/home/rohan/.hermes/node/bin:/home/rohan/.hermes/bin:/usr/local/bin:/usr/bin:/bin
Environment=SCOUTLINE_API=http://127.0.0.1:8787
Environment=NIGHTLY_MARKET=slc
Environment=NIGHTLY_AREAS=2
Environment=NIGHTLY_CATEGORIES=3
Environment=NIGHTLY_LIMIT=25
EnvironmentFile=/home/rohan/.hermes/scoutline.env
# bws supplies the Telegram alert settings when they are in the project.
ExecStart=/home/rohan/.hermes/bin/bws run --project-id f132f7b5-b6cd-49ab-979a-b4c6007f22a6 -- /home/rohan/.hermes/node/bin/node /home/rohan/projects/scoutline/current/server/cli.js nightly
TimeoutStartSec=3h
MemoryMax=256M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
