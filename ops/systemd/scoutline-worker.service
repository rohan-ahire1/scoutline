[Unit]
Description=Scoutline worker (discovery, site scans, screenshots; one job at a time)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rohan
Group=rohan
WorkingDirectory=/home/rohan/projects/scoutline/current
Environment=NODE_ENV=production
Environment=SCOUTLINE_ROLE=worker
# The worker exits between jobs when a deploy moves this link, and systemd
# starts it again on the new release.
Environment=SCOUTLINE_RELEASE_LINK=/home/rohan/projects/scoutline/current
Environment=PATH=/home/rohan/.hermes/node/bin:/home/rohan/.hermes/bin:/home/rohan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=/home/rohan/.hermes/scoutline.env
EnvironmentFile=-/home/rohan/.config/scoutline/service.env
ExecStart=/home/rohan/.hermes/bin/bws run --project-id f132f7b5-b6cd-49ab-979a-b4c6007f22a6 -- /home/rohan/.hermes/node/bin/node /home/rohan/projects/scoutline/current/server/index.js
Restart=always
RestartSec=5
# SIGTERM lets the current job finish; past this it is killed and its job
# goes back to the queue on the next start.
TimeoutStopSec=110
# One Chromium at a time plus Node.
MemoryMax=1536M
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
