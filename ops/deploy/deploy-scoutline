#!/usr/bin/env bash
set -Eeuo pipefail

mode=${1:-}
sha=${2:-}
signature=${3:-}

[[ "$mode" == "--stdin" ]] || {
  echo "deploy requires a signed archive stream" >&2
  exit 2
}
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || { echo "invalid commit SHA" >&2; exit 2; }
[[ "$signature" =~ ^[0-9a-f]{64}$ ]] || { echo "invalid artifact signature" >&2; exit 2; }

hmac_file=/etc/github-deploy/artifact-hmac.key
[[ -r "$hmac_file" ]] || { echo "artifact verification key is unavailable" >&2; exit 2; }

max_archive_bytes=$((512 * 1024 * 1024))
archive=$(mktemp /tmp/scoutline-deploy.XXXXXX.tgz)

base=/home/rohan/projects/scoutline
release_root="$base/releases"
current="$base/current"
stage="$release_root/$sha"
service=scoutline.service
health_url=http://127.0.0.1:8787/api/auth/config
export PATH=/home/rohan/.hermes/node/bin:/home/rohan/.hermes/bin:/home/rohan/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

stage_created=0
switched=0
cleanup() {
  rm -f -- "$archive"
  if (( stage_created == 1 && switched == 0 )) && [[ -d "$stage" ]]; then
    rm -rf -- "$stage"
  fi
}
trap cleanup EXIT

if ! /usr/bin/head -c "$((max_archive_bytes + 1))" > "$archive"; then
  echo "failed to receive release archive" >&2
  exit 2
fi
archive_size=$(stat -c '%s' "$archive")
(( archive_size > 0 && archive_size <= max_archive_bytes )) || {
  echo "release archive is empty or too large" >&2
  exit 2
}

verification_key=$(<"$hmac_file")
actual_signature=$(/usr/bin/openssl dgst -sha256 -hmac "$verification_key" "$archive" | /usr/bin/awk '{print $NF}')
[[ "$actual_signature" == "$signature" ]] || {
  echo "artifact signature verification failed" >&2
  exit 2
}
chown rohan:rohan "$archive"
chmod 600 "$archive"

mkdir -p "$release_root"
chown root:root "$release_root"
chmod 755 "$release_root"
if [[ -e "$stage" ]]; then
  echo "release already exists: $stage" >&2
  exit 2
fi
mkdir "$stage"
stage_created=1
chown rohan:rohan "$stage"

if ! tar -tzf "$archive" | LC_ALL=C awk '
  {
    path = $0
    sub(/^\.\//, "", path)
    if (path ~ /^\// || path ~ /(^|\/)\.\.(\/|$)/) {
      print "unsafe archive path: " path > "/dev/stderr"
      bad = 1
    }
  }
  END { exit bad }
'; then
  exit 2
fi

/usr/sbin/runuser -u rohan -- tar --no-same-owner --no-same-permissions -xzf "$archive" -C "$stage"

test -f "$stage/package.json"
test -f "$stage/dist/index.html"
test -d "$stage/node_modules"
if [[ -e "$stage/data" || -L "$stage/data" ]]; then
  echo "release archive must not contain data" >&2
  exit 2
fi
ln -s "$base/data" "$stage/data"

[[ -L "$current" ]] || { echo "current release link is missing" >&2; exit 2; }
previous=$(readlink "$current")
[[ -d "$previous" ]] || { echo "previous release directory is missing" >&2; exit 2; }

ln -s "$stage" "$current.next.$$"
mv -Tf "$current.next.$$" "$current"
switched=1

rollback() {
  echo "Scoutline health check failed; rolling back" >&2
  ln -s "$previous" "$current.rollback.$$"
  mv -Tf "$current.rollback.$$" "$current"
  systemctl restart "$service" || true
  switched=0
}
trap rollback ERR

systemctl restart "$service"
for attempt in $(seq 1 30); do
  if systemctl is-active --quiet "$service" && curl -fsS --max-time 2 "$health_url" >/dev/null; then
    trap - ERR
    echo "Scoutline deployed: $sha"
    exit 0
  fi
  sleep 1
done

false
