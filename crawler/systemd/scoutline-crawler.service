[Unit]
Description=Scoutline continuous web crawler
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=rohan
WorkingDirectory=/home/rohan/projects/scoutline-crawler
EnvironmentFile=/home/rohan/projects/scoutline-crawler/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
