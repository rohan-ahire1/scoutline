DATABASE_URL=postgres://crawler:crawler@127.0.0.1:5432/crawler
CRAWLER_USER_AGENT=ScoutlineCrawler/0.3 (+https://your-domain.example/crawler)
WORKER_ID=vps-1
CONCURRENCY=5
PER_HOST_DELAY_MS=3000
REQUEST_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=5000000
MAX_PAGES_PER_DOMAIN=5
MAX_TEXT_CHARS_PER_PAGE=8000
DAILY_SITE_LIMIT=1000
VISUAL_RISK_ELIGIBILITY_THRESHOLD=60
DEFAULT_INTERVAL_MINUTES=1440
SCHEDULER_INTERVAL_MS=30000
ROBOTS_CACHE_MINUTES=360

STALE_JOB_MINUTES=30
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8791
